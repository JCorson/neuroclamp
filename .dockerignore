# Allowlist: only what the image needs to build and run the app.
# Any new top-level file or directory the app reads at runtime must be added here,
# and to the path filter in .github/workflows/docker.yml.
*
!pyproject.toml
!uv.lock
!.python-version
!rxconfig.py
# Not read by the app; shipped so the published image carries the GPL text.
!LICENSE
!patch_sim/
!patch_sim_ui/
!assets/

# Generated or cached content inside the allowed paths.
**/__pycache__
**/*.py[cod]
assets/external
